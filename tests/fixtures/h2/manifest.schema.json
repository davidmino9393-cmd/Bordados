{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manifiesto del conjunto de imágenes de prueba para H2",
  "description": "Describe cada imagen del conjunto de evaluación (15–20) con sus derechos de uso y el resultado esperado. Las variantes de un mismo logo comparten design_family y no cuentan como diseños nuevos.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "set_name", "images"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "set_name": { "type": "string", "minLength": 1 },
    "images": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/image" } }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "design_family", "category", "format", "has_transparency", "contains_text", "expected_colors", "target_size_mm", "expected_outcome", "rights"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "file": { "type": "string", "minLength": 1, "description": "Ruta relativa al manifiesto, sin rutas absolutas ni de esta máquina." },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "design_family": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "description": "Mismo logo en distintas escalas o recortes = misma familia." },
        "variant_of": { "type": ["string", "null"] },
        "category": { "enum": ["flat_logo", "few_colors_drawing", "line_art", "lettering", "closed_curves_with_holes", "transparency", "expects_review"] },
        "format": { "enum": ["png", "jpeg", "svg"] },
        "pixel_size": {
          "type": "object", "additionalProperties": false, "required": ["width", "height"],
          "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }
        },
        "has_transparency": { "type": "boolean" },
        "contains_text": { "type": "boolean" },
        "text": { "type": ["string", "null"], "description": "Texto visible tal cual, para comprobar que la IA no lo cambia." },
        "expected_colors": { "type": "integer", "minimum": 1, "maximum": 16 },
        "target_size_mm": {
          "type": "object", "additionalProperties": false, "required": ["width_mm", "height_mm"],
          "properties": { "width_mm": { "type": "number", "exclusiveMinimum": 0 }, "height_mm": { "type": "number", "exclusiveMinimum": 0 } }
        },
        "expected_outcome": { "enum": ["automatic", "needs_review", "unsupported"] },
        "expected_review_reason": { "type": ["string", "null"], "description": "Obligatorio si expected_outcome es needs_review." },
        "known_traps": { "type": "array", "items": { "type": "string" }, "description": "Líneas finas, texto pequeño, degradados, huecos, etc." },
        "rights": {
          "type": "object", "additionalProperties": false,
          "required": ["owner", "license", "permission_confirmed"],
          "properties": {
            "owner": { "type": "string", "minLength": 1 },
            "license": { "type": "string", "minLength": 1 },
            "permission_confirmed": { "type": "boolean" },
            "permission_note": { "type": ["string", "null"] }
          }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
