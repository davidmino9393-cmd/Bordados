# true = usa respuestas SIMULADAS (src/mocks, fixtures en mocks/). Sin esta variable
# la web habla con el backend real del mismo origen (/api/v1).
VITE_USE_MOCKS=true
# Opcional: origen de la API si no es el mismo que sirve la web.
# VITE_API_BASE_URL=
# Solo desarrollo: reenvía /api al backend (no llega al navegador).
# API_PROXY_TARGET=http://localhost:8000
